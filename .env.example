# DiscoveryDesk environment variables (ARCH-6)
# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string (local dev or Railway managed Postgres)
DATABASE_URL="postgresql://user:password@host:5432/discoverydesk"

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Resend API key for sending magic-link emails (https://resend.com)
RESEND_API_KEY=""

# Verified sender address for outbound email, e.g. "DiscoveryDesk <onboarding@resend.dev>"
EMAIL_FROM=""
